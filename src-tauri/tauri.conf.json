{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "desktop-pet",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../dist/desktop-pet/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
  "windows": [
    {
      "title": "Desktop Pet",
      "width": 300,
      "height": 300,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "resizable": false,
      "skipTaskbar": false
    }
  ]
},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
